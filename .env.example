# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Only needed if your key is not scoped to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Claude model used by all agents (optional, defaults to claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional overrides for local folders (relative to the project root)
DATA_DIR=data
OUTPUT_DIR=output

# Excel tracker (defaults to data/tracker.xlsx). Work on a COPY of your real tracker.
TRACKER_PATH=
# Sheet that receives new rows (empty = first sheet with Empresa/Puesto-style headers)
TRACKER_SHEET=
TRACKER_INITIAL_STATUS=Por aplicar

# Follow-ups: flag contacts/applications silent for more than N days;
# never draft a new follow-up to the same recipient/company within N days.
FOLLOWUP_STALE_DAYS=7
FOLLOWUP_COOLDOWN_DAYS=7

# Reasoning effort for the requirements check and the HR reviewer (low | medium | high).
# Lower = cheaper. Leave empty to use the model's default. The CV writer always uses the default.
REVIEW_EFFORT=low

# Optional second provider: DeepSeek (cheaper). Which provider each role uses is set per role.
# anthropic = Claude (default) | deepseek = DeepSeek. Data sent to DeepSeek leaves Anthropic's
# servers: it includes your profile and the text of your CV facts.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
WRITER_PROVIDER=anthropic
REVIEW_PROVIDER=anthropic
