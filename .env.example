# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Only needed if your key is not scoped to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Claude model used by all agents (optional, defaults to claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional overrides for local folders (relative to the project root)
DATA_DIR=data
OUTPUT_DIR=output

# Excel tracker (defaults to data/tracker.xlsx). Work on a COPY of your real tracker.
TRACKER_PATH=
# Sheet that receives new rows (empty = first sheet with Empresa/Puesto-style headers)
TRACKER_SHEET=
TRACKER_INITIAL_STATUS=Por aplicar

# Follow-ups: flag contacts/applications silent for more than N days;
# never draft a new follow-up to the same recipient/company within N days.
FOLLOWUP_STALE_DAYS=7
FOLLOWUP_COOLDOWN_DAYS=7
