# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Claude model used by all agents (optional, defaults to claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional overrides for local folders (relative to the project root)
DATA_DIR=data
OUTPUT_DIR=output
